---
import { withBasePath } from '../lib/paths'

interface Props {
  src: string
  alt: string
  caption: string
  width?: number
}
const { src, alt, caption, width } = Astro.props
---

<figure>
  <img src={withBasePath(import.meta.env.BASE_URL, src)} alt={alt} width={width} loading="lazy" />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  figure {
    margin: 1.6em 0;
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  figcaption {
    font-size: 13px;
    color: var(--muted);
    margin-top: 6px;
  }
</style>
