---
interface Props {
  title: string
  tone?: 'info' | 'warn'
}
const { title, tone = 'info' } = Astro.props
---

<aside class:list={['notice', tone]} role="note">
  <strong>{title}</strong>
  <div><slot /></div>
</aside>

<style>
  .notice {
    border-left: 3px solid var(--muted);
    background: var(--card);
    padding: 10px 14px;
    margin: 1em 0;
    font-size: 14px;
    line-height: 1.75;
  }
  .notice strong {
    display: block;
    margin-bottom: 2px;
  }
  .notice.warn {
    border-left-color: var(--accent);
    background: #fff8ef;
  }
  .notice.warn strong {
    color: var(--accent);
  }
</style>
