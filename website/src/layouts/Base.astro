---
import '../styles/global.css'
import { withBasePath } from '../lib/paths'
import { SITE } from '../lib/site'

interface Props {
  title: string
  description: string
  wide?: boolean
  jsonLd?: object[]
}

const { title, description, wide = false, jsonLd = [] } = Astro.props
const base = import.meta.env.BASE_URL
const canonical = new URL(Astro.url.pathname, Astro.site).href
const nav = [
  { href: '/quickstart', label: '快速开始' },
  { href: '/docs', label: '文档' },
  { href: '/architecture', label: '架构' },
  { href: '/blog', label: '博客' },
  { href: '/changelog', label: '更新日志' },
]
const current = Astro.url.pathname
const fullTitle = title === SITE.name ? SITE.name : `${title} · ${SITE.name}`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBasePath(base, '/favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} 博客`} href={withBasePath(base, '/feed.xml')} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={withBasePath(base, '/')}>{SITE.name}</a>
        <nav aria-label="主导航">
          {
            nav.map((n) => {
              const href = withBasePath(base, n.href)
              return (
                <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                  {n.label}
                </a>
              )
            })
          }
          <a href={SITE.repo}>GitHub</a>
        </nav>
      </div>
    </header>
    <main>
      <div class:list={['prose', { wide }]}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="bar">
        <span>MIT License</span>
        <a href={SITE.repo}>GitHub</a>
        <a href={withBasePath(base, '/support')}>支持</a>
        <a href={withBasePath(base, '/llms.txt')}>llms.txt</a>
      </div>
    </footer>
  </body>
</html>
